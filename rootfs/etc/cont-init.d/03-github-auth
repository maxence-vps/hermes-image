#!/command/with-contenv sh
# Log gh into GitHub at every container start from $GH_TOKEN (or $GITHUB_TOKEN),
# then make git use gh as its credential helper.
#
# Why: Hermes strips GH_TOKEN/GITHUB_TOKEN from the environment of the commands it
# runs, so gh/git can't rely on the env var. gh stores the token under $HOME/.config/gh
# (persistent volume) and it is refreshed on every start.
#
# Two homes are configured: /opt/data/home is the HOME of the commands Hermes runs,
# /opt/data is the hermes user's login HOME (e.g. `su hermes` from a Dokploy terminal).

TOKEN="${GH_TOKEN:-${GITHUB_TOKEN:-}}"
if [ -z "$TOKEN" ]; then
  echo "[github-auth] no GH_TOKEN/GITHUB_TOKEN set, skipping"
  exit 0
fi

for H in /opt/data/home /opt/data; do
  mkdir -p "$H" && chown hermes:hermes "$H"
  as_hermes() { s6-setuidgid hermes env -u GH_TOKEN -u GITHUB_TOKEN HOME="$H" "$@"; }

  if printf '%s' "$TOKEN" | as_hermes gh auth login --hostname github.com --git-protocol https --with-token \
     && as_hermes gh auth setup-git --hostname github.com; then
    echo "[github-auth] HOME=$H: $(as_hermes gh api user --jq '"logged in as " + .login' 2>&1 | head -n 1)"
  else
    echo "[github-auth] HOME=$H: gh auth login failed, continuing"
  fi
done
exit 0
